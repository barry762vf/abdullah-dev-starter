# Same-origin /api/* proxy (ADR 011/014). Methods, bodies, status codes and every Set-Cookie
# header pass through unchanged; cookies stay host-only on the public origin.
proxy_pass ${API_UPSTREAM};
proxy_http_version 1.1;
proxy_set_header Connection "";
proxy_set_header Host $host;
proxy_redirect off;
proxy_read_timeout 30s;

# The API trusts only this pair: the observed peer and the shared proxy credential. Client-sent
# copies are overwritten, and generic forwarding headers are blanked so nothing downstream
# can mistake a spoofed X-Forwarded-For for the client address.
proxy_set_header X-Edge-Client-IP $remote_addr;
proxy_set_header X-Edge-Proxy-Secret "${EDGE_PROXY_SECRET}";
proxy_set_header X-Forwarded-For "";
proxy_set_header X-Real-IP "";
proxy_set_header Forwarded "";

# Authenticated JSON is never cacheable, whatever the upstream sent.
proxy_hide_header Cache-Control;
add_header Cache-Control "no-store" always;
