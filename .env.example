# Local development template only. Copy to .env and replace every example secret
# before using a shared machine, exposed database port, or production deployment.
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-secure-256-bit-hex-in-production

# Local Docker PostgreSQL. Keep POSTGRES_PASSWORD and DATABASE_URL in sync.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=abdullah_core_dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/abdullah_core_dev
# Dedicated schema/data test database. Never point this at POSTGRES_DB.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/abdullah_core_test

# Backend and browser origins. Production must use explicit HTTPS origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
COOKIE_SECURE=false

# Set only while running the explicit --bootstrap-admin command, then remove.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Optional integrations; empty credentials leave them disabled.
AI_PROVIDER=disabled
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
SUPABASE_URL=
SUPABASE_KEY=
