# Local development template only. Copy to .env and replace every example secret
# before using a shared machine, exposed database port, or production deployment.
# Required. Use development only for local work; set production explicitly on deployment.
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-secure-256-bit-hex-in-production

# Local Docker PostgreSQL. Keep POSTGRES_PASSWORD and DATABASE_URL in sync.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=abdullah_core_dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/abdullah_core_dev
# Dedicated schema/data test database. Never point this at POSTGRES_DB.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/abdullah_core_test

# Backend and browser origins. Production must use explicit HTTPS origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
COOKIE_SECURE=false

# Client IP for rate limits/audit (ADR 014). Local: the socket peer. Production behind the
# bundled proxy: edge_header plus a shared EDGE_PROXY_SECRET (see deploy/production.env.example).
CLIENT_IP_SOURCE=peer
EDGE_PROXY_SECRET=

# Optional per-process database pool and API docs (docs default on only in development).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DATABASE_TRANSACTION_POOLER=false
# API_DOCS_ENABLED=

# Set only while running the explicit --bootstrap-admin command, then remove.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Optional integrations; empty credentials leave them disabled.
AI_PROVIDER=disabled
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MESSENGER_PROVIDER=disabled
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
STORAGE_PROVIDER=disabled
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=
EMAIL_PROVIDER=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
