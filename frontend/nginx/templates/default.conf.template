# Rendered by the nginx image entrypoint (envsubst) into /etc/nginx/conf.d at container start.
# Only ${API_UPSTREAM} and ${EDGE_PROXY_SECRET} are substituted; $nginx_variables are untouched.

# Shared per-IP auth limits at the single ingress (all API workers/instances sit behind it).
# $remote_addr is the TCP peer. If a load balancer terminates TLS in front of this container,
# configure the realip module for that balancer's address range (see docs/DEPLOYMENT_STRATEGY.md).
limit_req_zone $binary_remote_addr zone=auth_login:10m rate=5r/m;
# nginx has no per-hour rate: 1/min with a burst of 2 here; the app keeps its stricter 3/hour.
limit_req_zone $binary_remote_addr zone=auth_register:10m rate=1r/m;
limit_req_status 429;
server_tokens off;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    client_max_body_size 1m;

    error_page 429 = @rate_limited;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /api/v1/auth/login {
        limit_req zone=auth_login burst=5 nodelay;
        include /etc/nginx/conf.d/snippets/api-proxy.conf;
    }

    location = /api/v1/auth/register {
        limit_req zone=auth_register burst=2 nodelay;
        include /etc/nginx/conf.d/snippets/api-proxy.conf;
    }

    location /api/ {
        include /etc/nginx/conf.d/snippets/api-proxy.conf;
    }

    # Cloudflare Pages configuration file shipped in dist/; not content for this server.
    location = /_headers {
        return 404;
    }

    # Content-hashed build assets never change.
    location /assets/ {
        include /etc/nginx/conf.d/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # SPA routes fall back to index.html, which is always revalidated.
    location / {
        include /etc/nginx/conf.d/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }

    location @rate_limited {
        default_type application/problem+json;
        add_header Cache-Control "no-store" always;
        add_header Retry-After "60" always;
        return 429 '{"type":"about:blank","title":"Too Many Requests","status":429,"detail":"Too many attempts. Try again later."}';
    }
}
