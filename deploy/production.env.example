# Copy to deploy/production.env (git-ignored) and fill every value. Never commit real values.
# Generate secrets with: python -c "import secrets; print(secrets.token_hex(32))"

# Public HTTPS origin users open (one origin serves the SPA and /api/*).
PUBLIC_ORIGIN=https://app.example.com

# 64 hexadecimal characters.
SECRET_KEY=
# Shared by the web proxy and the API; at least 32 characters.
EDGE_PROXY_SECRET=

POSTGRES_USER=app
# URL-safe characters only (hex recommended): it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=
POSTGRES_DB=abdullah_core

# Optional tuning. Keep DB_POOL_SIZE + DB_MAX_OVERFLOW, times WEB_CONCURRENCY, below the
# database connection limit.
# WEB_CONCURRENCY=2
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# WEB_BIND=127.0.0.1
# WEB_PORT=8080

# Do NOT put INITIAL_ADMIN_* here. Bootstrap once with a one-off command (see
# docs/DEPLOYMENT_STRATEGY.md); the API refuses to start while INITIAL_ADMIN_PASSWORD is set.

# Optional Phase 8 providers; keep disabled unless credentials and network egress are intended.
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# MESSENGER_PROVIDER=telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=                    # 32-256 characters: A-Z a-z 0-9 _ -
# STORAGE_PROVIDER=supabase
# SUPABASE_URL=https://project.supabase.co
# SUPABASE_KEY=
# SUPABASE_BUCKET=avatars
# EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_STARTTLS=true
